pipeline {
    agent any
 
    environment {
        TOMCAT_URL        = 'http://172.31.15.104:8080'   // Tomcat private IP (deploys)
        TOMCAT_PUBLIC_URL = 'http://51.21.98.206.190:8080' // Tomcat Elastic IP (browsing)
        CONTEXT_PATH      = '/devops-trends'
    }
 
    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling source code from GitHub...'
                git branch: 'main',
                    credentialsId: 'github-pat',
                    url: 'https://github.com/awanmercy/devops-trends.git'
            }
        }
 
        stage('Build & Test') {
            steps {
                echo 'Compiling and running unit tests...'
                // 'mvn clean test' compiles the code and executes unit tests in one go
                sh 'mvn -B clean test'
            }
        }
 
        stage('Package') {
            steps {
                echo 'Packaging into WAR file...'
                // Since tests already passed in the previous stage, we package without running tests again
                sh 'mvn -B package -DskipTests'
            }
        }
 
        stage('Deploy to Tomcat') {
            steps {
                echo "Deploying to Tomcat EC2 at ${TOMCAT_URL}..."
                deploy adapters: [
                    tomcat9(
                        credentialsId: 'tomcatcreds',
                        url: "${TOMCAT_URL}"
                    )
                ],
                contextPath: "${CONTEXT_PATH}",
                war: 'target/devops-trends.war'
            }
        }
    }
 
    post {
        success {
            echo 'Deployment successful!'
            echo "Deployed to ${TOMCAT_URL}${CONTEXT_PATH} (Tomcat private IP)"
            echo "View the app at ${TOMCAT_PUBLIC_URL}${CONTEXT_PATH}"
        }
        failure {
            echo 'Pipeline failed. Check console output for details.'
        }
        always {
            echo 'Pipeline finished. Cleaning workspace...'
            deleteDir()
        }
    }
}